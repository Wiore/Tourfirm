@inherits LayoutComponentBase

<div class="app-shell">
    <header class="topbar">
        <div class="brand">🌍 Turfirm</div>
        <nav class="nav-links">
            @if (session.IsLoggedIn)
            {
                <NavLink class="nav-item" href="@dashboardHref">Личный кабинет</NavLink>
                @if (session.IsEmployee)
                {
                    <NavLink class="nav-item" href="/export">Экспорт данных</NavLink>
                }
                <button class="nav-item nav-btn" @onclick="Logout">
                    Выйти (@session.CurrentUser?.NickName)
                </button>
            }
            else
            {
                <NavLink class="nav-item" href="/">Вход</NavLink>
                <NavLink class="nav-item" href="/register">Регистрация</NavLink>
            }
        </nav>
    </header>

    <main class="content">
        @Body
    </main>

    <footer class="footer">
        <span>Turfirm © 2026</span>
    </footer>
</div>

@code {
    [Inject] private UserSession session { get; set; } = default!;
    [Inject] private NavigationManager nav { get; set; } = default!;

    private string dashboardHref => session.IsEmployee ? "/employee" : "/client";

    private void Logout()
    {
        session.Logout();
        nav.NavigateTo("/");
    }
}
