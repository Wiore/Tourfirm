@page "/export"
@rendermode InteractiveServer
@inject HttpClient Http
@inject UserSession Session
@inject IJSRuntime JS

@if (!Session.IsEmployee)
{
    <div class="card">
        <h1>Доступ запрещён</h1>
        <p class="muted">Экспорт доступен только сотрудникам. <a href="/">Войти как сотрудник</a></p>
    </div>
}
else
{
    <div class="card">
        <h1>Экспорт данных</h1>
        <p>
            Выгрузка заявок со связанными предложениями и позициями в четыре формата
            (лабораторная работа №5: JSON, CSV, XML, YAML).
        </p>

        <button class="btn primary" @onclick="RunExportAsync" disabled="@busy">
            @(busy ? "Экспорт…" : "Сформировать data.json / .csv / .xml / .yaml")
        </button>

        @if (!string.IsNullOrEmpty(info))  { <div class="alert success">@info</div> }
        @if (!string.IsNullOrEmpty(error)) { <div class="alert error">@error</div> }

        @if (done)
        {
            <h2>Скачать</h2>
            <div class="download-grid">
                <button class="btn" @onclick='() => Download("json")'>data.json</button>
                <button class="btn" @onclick='() => Download("csv")'>data.csv</button>
                <button class="btn" @onclick='() => Download("xml")'>data.xml</button>
                <button class="btn" @onclick='() => Download("yaml")'>data.yaml</button>
            </div>
            <p class="muted hint">Файлы также сохранены в папку <code>out/</code> проекта API.</p>
        }
    </div>
}

@code {
    private bool busy;
    private bool done;
    private string? info;
    private string? error;

    private async Task RunExportAsync()
    {
        busy = true;
        info = null;
        error = null;
        done = false;
        try
        {
            // POST /api/export/run?userId=...
            var resp = await Http.PostAsync($"api/export/run?userId={Session.CurrentUser!.Id}", null);
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<ExportRunResult>();
                info = $"Готово: выгружено {body?.recordsCount ?? 0} записей в папку \"{body?.directory}\".";
                done = true;
            }
            else
            {
                error = await resp.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            error = "Не удалось связаться с API: " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Download(string format)
    {
        string url = $"{Http.BaseAddress}api/export/download/{format}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    // Форма ответа /api/export/run.
    private sealed record ExportRunResult(string directory, int recordsCount);
}
