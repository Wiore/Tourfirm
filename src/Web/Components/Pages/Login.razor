@page "/"
@page "/login"
@rendermode InteractiveServer
@inject HttpClient Http
@inject UserSession Session
@inject NavigationManager Nav

<div class="card auth-card">
    <h1>Вход в систему</h1>

    <EditForm Model="@form" FormName="login" OnValidSubmit="@EnterAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <label>
            Логин
            <InputText @bind-Value="form.Login" placeholder="employer" />
        </label>

        <label>
            Пароль
            <InputText type="password" @bind-Value="form.Password" placeholder="••••••" />
        </label>

        <button type="submit" class="btn primary" disabled="@busy">
            @(busy ? "Вход…" : "Войти")
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert error">@error</div>
    }

    <p class="muted">Нет аккаунта? <a href="/register">Зарегистрироваться</a></p>
</div>

@code {
    private LoginModel form = new();
    private bool busy;
    private string? error;

    private async Task EnterAsync()
    {
        busy = true;
        error = null;
        try
        {
            // GET /api/users/{login}/{password}
            var resp = await Http.GetAsync(
                $"api/users/{Uri.EscapeDataString(form.Login)}/{Uri.EscapeDataString(form.Password)}");

            if (resp.IsSuccessStatusCode)
            {
                var user = await resp.Content.ReadFromJsonAsync<UserData>();
                if (user is not null)
                {
                    Session.SetUser(user);
                    Nav.NavigateTo(user.Role == 1 ? "/employee" : "/client");
                }
            }
            else
            {
                error = await resp.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            error = "Не удалось связаться с API: " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Введите логин")]
        public string Login { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Введите пароль")]
        public string Password { get; set; } = "";
    }
}
